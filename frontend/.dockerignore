# Host-installed dependencies: `npm ci` reinstalls them for Alpine/Linux inside
# the build stage. Copying the Windows-built tree in would both bloat the build
# context and risk platform-specific binaries.
node_modules/

# Build output — regenerated by `npm run build` in the image
dist/

# Playwright scratch scripts used during development; not part of the app
_check*.mjs

.env
.env.*
*.log
