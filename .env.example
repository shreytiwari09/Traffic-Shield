# Copy this file to .env and fill in as needed. .env is never committed.
# Every value below has a working default in services/shared/settings.py —
# you only need to set GEMINI_API_KEY to unlock the Gemini provider.

# --- Gemini ------------------------------------------------------------------
# Leave blank for now; the Ask tab still works fine on Ollama only, and Eval
# tab's Gemini cells will just show "unavailable" until this is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Ollama --------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- inter-service URLs (only change if you move a service to a different port) --
DATA_SERVICE_URL=http://localhost:8004
LLM_SERVICE_URL=http://localhost:8003
RETRIEVAL_SERVICE_URL=http://localhost:8002
ORCHESTRATION_SERVICE_URL=http://localhost:8001
