# Copy this file to .env and fill in as needed. .env is never committed.
# Every value below has a working default in services/shared/settings.py —
# you only need to set GEMINI_API_KEY to unlock the Gemini provider.

# --- Gemini ------------------------------------------------------------------
# Leave blank for now; the Ask tab still works fine on Ollama only, and Eval
# tab's Gemini cells will just show "unavailable" until this is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Ollama --------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# --- Neo4j (graph backend for Retrieval Service) --------------------------------
# The graph half of hybrid retrieval. Like Ollama, the SERVER is infrastructure
# this app points at rather than embeds — see README 'Graph database (Neo4j)'
# for starting it, then load the graph with:
#     python -m scripts.load_neo4j
# Set GRAPH_BACKEND=json to run entirely without Neo4j on the original
# flat-JSON store; retrieval still works, it just cannot do multi-hop.
GRAPH_BACKEND=neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# If Neo4j is unreachable at startup, fall back to the JSON store rather than
# leaving retrieval with no graph path at all. /v1/health reports when this has
# happened ("fell_back": true).
NEO4J_FALLBACK_TO_JSON=true
# 1 = evidence from the matched entity's own relationships (matches the old
# JSON behavior exactly). 2 = also reach one hop further, through connected
# entities — only possible on the graph database, and slower: every extra
# candidate is a real embedding fetch and cosine scoring round trip.
GRAPH_EXPAND_HOPS=1

# --- inter-service URLs (only change if you move a service to a different port) --
DATA_SERVICE_URL=http://localhost:8004
LLM_SERVICE_URL=http://localhost:8003
RETRIEVAL_SERVICE_URL=http://localhost:8002
ORCHESTRATION_SERVICE_URL=http://localhost:8001

# --- slow / CPU-only hosts -------------------------------------------------------
# Raise if Ollama generation times out (empty "ollama generation failed:" error).
OLLAMA_TIMEOUT_SECONDS=600
# Keep the model loaded between questions so the first ask after an idle gap
# does not pay a multi-GB cold load. Set 0 to free RAM after each call.
OLLAMA_KEEP_ALIVE=30m
